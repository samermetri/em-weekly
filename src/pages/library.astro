---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import {href} from '../lib/data';
import '../styles/reading-space.css';
---
<Layout title="My Library" pageClass="library-dashboard">
 <div class="reading-space">
 <p class="account-status" data-account-status role="status" aria-live="polite">Loading your library…</p>
 <button id="retry-library" class="btn" hidden>Try again</button>
 <div class="library-grid" id="personal-library" aria-busy="true" inert>
 <aside class="panel library-folders" id="library-folders-panel"><details id="library-collections" open><summary class="folders-heading"><span>My folders</span><Icon name="folder" size={17}/></summary><div id="folder-list"></div><button class="link-button new-folder-trigger" id="create-folder"><Icon name="plus" size={16}/> New folder</button></details><div class="library-profile"><span class="library-avatar" data-avatar aria-hidden="true"><Icon name="bookmark" size={17}/></span><div><a href={href('account/')}>Your account <Icon name="arrow" size={13}/></a><span data-email></span></div></div><a class="admin-entry" id="admin-link" hidden href={href('admin/')}><Icon name="edit" size={15}/> Manage articles</a></aside>
 <section class="library-content" aria-labelledby="library-title">
 <header class="library-toolbar">
 <button class="btn folder-drawer-toggle" id="toggle-folders" aria-label="Open folders" aria-controls="library-folders-panel" aria-expanded="false"><Icon name="folder" size={18}/></button>
 <div class="library-toolbar-title"><h1 id="library-title" tabindex="-1">Favorites</h1><span id="library-count"></span></div>
 <a class="btn find-articles" href={href('articles/')}>Find articles</a>
 <label class="saved-search"><Icon name="search" size={17}/><span class="sr-only">Search saved articles</span><input id="saved-search" type="search" placeholder="Search saved articles"/></label>
 <label class="library-sort"><span class="sr-only">Sort saved articles</span><select id="saved-sort" aria-label="Sort saved articles"><option value="recent">Recently saved</option><option value="oldest">Oldest saved</option><option value="title">Title A–Z</option></select></label>
 <details class="library-menu" id="library-actions"><summary aria-label="Library actions">•••</summary><div><button type="button" class="link-button" id="select-shown">Select all shown</button><button class="link-button" id="refresh-library">Refresh library</button><div id="folder-tools" hidden><button class="link-button" id="rename-folder">Rename folder</button><button class="link-button danger" id="delete-folder">Delete folder</button></div></div></details>
 </header>
 <div class="digest-selection" id="digest-selection" hidden><span id="selection-summary" role="status" aria-live="polite">0 selected</span><div class="selection-actions"><button type="button" class="link-button" id="clear-selection" disabled>Clear</button><a class="btn primary small" id="print-selection" aria-disabled="true" tabindex="-1" href="#" target="_blank" rel="noopener noreferrer"><Icon name="download" size={15}/> Print selected</a></div></div>
 <div id="saved-articles" class="saved-grid"></div></section></div>
 <dialog id="folder-dialog" class="reader-dialog"><form id="new-folder" class="reader-form"><div><p class="eyebrow">MY LIBRARY</p><h2 id="folder-dialog-title">New folder</h2><p>Group articles around a topic or a clinical question.</p></div><label for="folder-name">Folder name<input id="folder-name" maxlength="60" required placeholder="e.g. Airway & intubation" autocomplete="off"/></label><p id="folder-error" class="form-error" role="alert" hidden></p><div class="reader-row"><button class="btn" type="button" id="cancel-folder">Cancel</button><button class="btn primary" type="submit" id="save-folder">Create folder</button></div></form></dialog>
 <div class="library-toast" id="library-toast" hidden><span id="toast-message" role="status"></span><button id="undo-remove" class="link-button">Undo</button><button id="dismiss-toast" class="link-button" aria-label="Dismiss notification">×</button></div>
 </div><script>import '../lib/client/library-page';</script>
</Layout>
