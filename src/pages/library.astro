---
import Layout from '../layouts/Layout.astro';import {href} from '../lib/data';
---
<Layout title="My Library"><div class="page-heading"><div><p class="eyebrow">YOUR READING LIST</p><h1>My Library</h1><p>Favorites and folders, saved across your devices.</p></div><div class="reader-row"><a class="btn" id="admin-link" hidden href={href('admin/')}>Manage articles</a><button class="btn" data-sign-out>Sign out</button></div></div><p class="muted" data-email></p><p class="account-status" data-account-status role="status" aria-live="polite">Loading your library…</p><div class="library-grid"><aside class="panel library-folders"><h2>Folders</h2><div id="folder-list"></div><form id="new-folder" class="reader-form"><label for="folder-name">New folder<input id="folder-name" maxlength="60" required placeholder="For my next shift"/></label><button class="btn" type="submit">Create folder</button></form></aside><section><div class="section-heading"><h2 id="library-title">Favorites</h2><button class="btn small" id="refresh-library">Refresh</button></div><div id="folder-tools" hidden class="reader-row"><button class="link-button" id="rename-folder">Rename folder</button><button class="link-button" id="delete-folder">Delete folder</button></div><div id="saved-articles"></div></section></div><script>import '../lib/client/library-page';</script></Layout>
