---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import {href} from '../lib/data';
---
<Layout title="My Library">
 <div class="page-heading library-heading"><div><p class="eyebrow">YOUR PRIVATE COLLECTION</p><h1>My Library</h1><p>Saved evidence, organized your way.</p></div><a class="btn primary" href={href('articles/')}>Browse articles <Icon name="arrow" size={17}/></a></div>
 <div class="library-account-bar"><div class="library-identity"><span class="library-avatar" data-avatar aria-hidden="true"><Icon name="bookmark" size={19}/></span><div><span class="identity-label">Your reading space</span><span data-email></span></div></div><div class="reader-row"><a class="btn small" id="admin-link" hidden href={href('admin/')}><Icon name="edit" size={15}/> Manage articles</a><button class="link-button" data-sign-out>Sign out</button></div></div>
 <p class="account-status" data-account-status role="status" aria-live="polite">Loading your library…</p>
 <div class="library-grid"><aside class="panel library-folders"><details id="library-collections" open><summary class="folders-heading"><span>Collections</span><Icon name="folder" size={18}/></summary><div id="folder-list"></div><form id="new-folder" class="reader-form"><label for="folder-name">New folder<input id="folder-name" maxlength="60" required placeholder="e.g. Airway"/></label><button class="btn" type="submit"><Icon name="plus" size={16}/> Create folder</button></form><p class="library-private"><Icon name="methods" size={14}/> Only you can see your folders.</p></details></aside>
 <section class="library-content"><div class="section-heading"><div><h2 id="library-title">Favorites</h2><p id="library-count" class="muted"></p></div><button class="btn small" id="refresh-library"><Icon name="refresh" size={14}/> Refresh</button></div><div class="saved-filters"><label class="saved-search"><Icon name="search" size={18}/><span class="sr-only">Search saved articles</span><input id="saved-search" type="search" placeholder="Search your saved articles…"/></label><label><span class="sr-only">Sort saved articles</span><select id="saved-sort" aria-label="Sort saved articles"><option value="recent">Recently saved</option><option value="oldest">Oldest saved</option><option value="title">Title A–Z</option></select></label></div><div class="digest-selection" id="digest-selection" hidden><div><span id="selection-summary" role="status" aria-live="polite">0 selected</span><p>Choose articles to print together as a reading digest.</p></div><div class="selection-actions"><button type="button" class="link-button" id="select-shown">Select all shown</button><button type="button" class="link-button" id="clear-selection" disabled>Clear</button><a class="btn primary small" id="print-selection" aria-disabled="true" tabindex="-1" href="#" target="_blank" rel="noopener noreferrer"><Icon name="download" size={15}/> Print selected</a></div></div><div id="folder-tools" hidden class="reader-row"><button class="link-button" id="rename-folder">Rename folder</button><button class="link-button danger" id="delete-folder">Delete folder</button></div><div id="saved-articles" class="saved-grid"></div></section></div>
 <script>import '../lib/client/library-page';</script>
</Layout>
