---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {issues,href,formatDate} from '../../lib/data';
---
<Layout title="Weekly Updates"><div class="page-heading"><div><p class="eyebrow">YOUR WEEK, DISTILLED</p><h1>The weekly brief</h1><p>Permanent issues. Clear citations. A little more perspective for your next shift.</p></div></div><div class="archive-list">{issues.map(i=><article class="panel archive-card"><div class="archive-mark"><Icon name="weekly" size={28}/></div><div><p class="eyebrow">{i.sample?'HISTORICAL SAMPLE':'WEEKLY EDITION'} · {i.items.length} {i.items.length===1?'ARTICLE':'ARTICLES'}</p><h2><a href={href(`weekly/${i.id}/`)}>{i.title}</a></h2><p>Coverage: {formatDate(i.coverageStart)} through {formatDate(i.coverageEnd)}</p><p>{i.overview}</p><div class="archive-actions"><a class="btn primary" href={href(`weekly/${i.id}/`)}>Read issue <Icon name="arrow" size={16}/></a>{i.pdf.status==='ready'?<a class="btn" href={i.pdf.releaseUrl!}><Icon name="download" size={16}/> Download PDF</a>:<span class="pdf-status">PDF {i.pdf.status} · {i.pdf.status==='failed'?'Retry pending':'Being prepared'}</span>}</div></div></article>)}</div></Layout>
