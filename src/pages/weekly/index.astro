---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {issues,href,formatDate} from '../../lib/data';
---
<Layout title="Weekly Updates"><div class="page-heading"><div><p class="eyebrow">WEEKLY ARCHIVE</p><h1>The weekly brief</h1><p>Research and guidance first published during the preceding Monday–Sunday.</p></div></div><div class="archive-list">{issues.filter(i=>!i.sample).map(i=><article class="panel archive-card"><div class="archive-mark"><Icon name="weekly" size={28}/></div><div><p class="eyebrow">WEEKLY EDITION · {i.items.length} {i.items.length===1?'ARTICLE':'ARTICLES'}</p><h2><a href={href(`weekly/${i.id}/`)}>{i.title}</a></h2><p>Coverage: {formatDate(i.coverageStart)} through {formatDate(i.coverageEnd)}</p><p>{i.overview}</p><div class="archive-actions"><a class="btn primary" href={href(`weekly/${i.id}/`)}>Read issue <Icon name="arrow" size={16}/></a><a class="btn" href={href(`weekly/${i.id}/?print=1`)}><Icon name="download" size={16}/> Print / Save PDF</a></div></div></article>)}</div>{!issues.some(i=>!i.sample)&&<p class="muted">The first weekly brief is being prepared. Browse the article library while source checks are completed.</p>}</Layout>
