---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {issues,articles,href,formatDate} from '../../lib/data';import {sections} from '../../lib/schema';
export function getStaticPaths(){return issues.map(issue=>({params:{id:issue.id},props:{issue}}));}
const {issue:i}=Astro.props;
---
<Layout title="Weekly Updates" description={i.overview}><div class="issue-detail"><a class="back-link" href={href('weekly/')}>← Weekly archive</a><div class="issue-heading"><p class="eyebrow">{i.sample?'HISTORICAL SAMPLE ISSUE':'THE WEEKLY BRIEF'}</p><h1>{i.title}</h1><p class="coverage"><strong>Coverage:</strong> {formatDate(i.coverageStart)} through {formatDate(i.coverageEnd)} · America/Los_Angeles</p><div class="archive-actions">{i.pdf.status==='ready'?<a class="btn primary" href={i.pdf.releaseUrl!}><Icon name="download" size={16}/> Download PDF</a>:<span class="notice">PDF {i.pdf.status}. {i.pdf.status==='failed'?'Generation failed; the HTML brief remains available.':'The download will appear after upload verification.'}</span>}<span class="muted">AI-generated · Not yet human-reviewed</span></div></div><p class="issue-overview">{i.overview}</p><section class="clinical-takeaways"><p class="eyebrow">AT A GLANCE</p><h2>Clinical Takeaways</h2><ul>{i.clinicalTakeaways.map(t=><li>{t}</li>)}</ul></section>{(i.sectionOrder??sections).map(section=>{const items=i.items.filter(item=>item.section===section);return items.length>0&&<section class="digest-section"><h2>{section}</h2>{items.map(item=>{const a=articles.find(a=>a.id===item.articleId)!;return <article class="brief-entry">{item.catchUp&&<p class="tag">Catch-up: previously missed important publication</p>}<h3>{a.title}</h3><p class="brief-citation"><em>{a.source} - {formatDate(a.firstOnlineDate)}</em></p><p><strong>Summary:</strong> {a.summary}</p><p><strong>Why it matters:</strong> {a.whyItMatters}</p><p><strong>Limitations:</strong> {a.limitations}</p><p><strong>Source:</strong> <a href={a.doi?`https://doi.org/${a.doi}`:a.canonicalUrl}>{a.doi||a.canonicalUrl}</a></p><p><strong>Full text:</strong> <a href={a.canonicalUrl}>{a.fullTextStatus}</a></p><p class="muted">{a.evidenceNotes} AI-generated · {a.humanReview}.</p><a class="text-link" href={href(`articles/${a.id}/`)}>View study details <Icon name="arrow" size={15}/></a></article>})}</section>})}{i.otherUpdates.length>0&&<section class="prose-section"><h2>Other notable updates</h2><ul>{i.otherUpdates.map(t=><li>{t}</li>)}</ul></section>}<section class="prose-section"><h2>Publication notes</h2><p>Published on EM Weekly {formatDate(i.publishedDate)}. Selection prioritizes potential ED impact and methodological strength. Automated ranking is an editorial aid, not a definitive judgment of clinical importance.</p>{i.pdf.sha256&&<details><summary>PDF integrity</summary><p class="checksum">SHA-256: {i.pdf.sha256}</p></details>}</section></div></Layout>
