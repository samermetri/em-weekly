---
import Layout from '../../layouts/Layout.astro';import DocumentActions from '../../components/DocumentActions.astro';import PrintHeader from '../../components/PrintHeader.astro';import Icon from '../../components/Icon.astro';import {issues,articles,href,formatDate} from '../../lib/data';import {sections} from '../../lib/schema';
export function getStaticPaths(){return issues.map(issue=>({params:{id:issue.id},props:{issue}}));}
const {issue:i}=Astro.props;
const [briefTitle,briefDate]=i.title.split(' - ');
---
<Layout title={i.title} description={i.overview}><div class="issue-detail print-document"><PrintHeader/><a class="back-link" href={href('weekly/')}>← Weekly archive</a><div class="issue-heading"><p class="eyebrow">{i.sample?'HISTORICAL SAMPLE ISSUE':'WEEKLY LITERATURE BRIEF'}</p><h1>{briefTitle}{briefDate&&<span class="issue-date">{briefDate}</span>}</h1><p class="coverage"><strong>Coverage:</strong> {formatDate(i.coverageStart)} through {formatDate(i.coverageEnd)} · America/Los_Angeles</p><DocumentActions title={i.title} printTitle={`EM Weekly - Weekly Brief - ${i.coverageStart} to ${i.coverageEnd}`}/></div><p class="issue-overview">{i.withdrawn?'This brief was updated after an article was withdrawn. The remaining summaries appear below.':i.overview}</p>{!i.withdrawn&&<section class="clinical-takeaways"><p class="eyebrow">AT A GLANCE</p><h2>Clinical Takeaways</h2><ul>{i.clinicalTakeaways.map(t=><li>{t}</li>)}</ul></section>}{(i.sectionOrder??sections).map(section=>{const items=i.items.filter(item=>item.section===section);return items.length>0&&<section class="digest-section"><h2>{section}</h2>{items.map(item=>{const a=articles.find(a=>a.id===item.articleId)!;return <article class="brief-entry">{item.catchUp&&<p class="tag">Catch-up: previously missed important publication</p>}<h3>{a.title}</h3><p class="brief-citation"><em>{a.source} - {formatDate(a.firstOnlineDate)}</em></p><div class="brief-summary"><h4>Summary</h4><p>{a.summary}</p></div><div class="brief-analysis"><section><h4>Why it matters</h4><p>{a.whyItMatters}</p></section><section><h4>Limitations</h4><p>{a.limitations}</p></section></div><p><strong>Source:</strong> <a href={a.doi?`https://doi.org/${a.doi}`:a.canonicalUrl} target="_blank" rel="noopener noreferrer">{a.doi||a.canonicalUrl}</a></p><p><strong>Full text:</strong> <a href={a.officialPdfUrl||a.canonicalUrl} target="_blank" rel="noopener noreferrer">{a.fullTextStatus}</a></p><p class="muted">{a.evidenceNotes} {a.aiGenerated?'AI-generated':'Editor-written'} · {a.humanReview}.</p><a class="text-link" href={href(`articles/${a.id}/`)}>View study details <Icon name="arrow" size={15}/></a></article>})}</section>})}{i.otherUpdates.length>0&&<section class="prose-section"><h2>Other notable updates</h2><ul>{i.otherUpdates.map(t=><li>{t}</li>)}</ul></section>}<section class="prose-section publication-notes"><h2>Publication notes</h2><p>Published on EM Weekly {formatDate(i.publishedDate)}. Selection prioritizes potential ED impact and methodological strength. Automated ranking is an editorial aid, not a definitive judgment of clinical importance.</p></section><p class="print-footer">AI-generated · Not yet human-reviewed · Read the primary source and apply clinical judgment.</p></div></Layout>
