---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import DocumentActions from '../../components/DocumentActions.astro';
import PrintHeader from '../../components/PrintHeader.astro';
import Paragraphs from '../../components/Paragraphs.astro';
import {isGuidance} from '../../lib/guidance';
import {articles,topics,href,formatDate} from '../../lib/data';
export function getStaticPaths(){return articles.map(article=>({params:{id:article.id},props:{article}}));}
const {article:a}=Astro.props;
const printTitle=`EM Weekly - ${a.id.toUpperCase()} - ${a.firstOnlineDate}`;
---
<Layout title={a.shortTitle} description={a.summary}>
 <article class:list={["article-detail print-document",{"guidance-entry":isGuidance(a)}]}>
  <PrintHeader/>
  <a class="back-link" href={href('articles/')}>← All articles</a>
  {a.sample&&<p class="notice">Historical sample · This article is not presented as new evidence this week.</p>}
  <div class="article-top"><span class="tag">{a.studyType}</span><span class="study-type">{a.source}</span></div>
  <h1>{a.title}</h1>
  <p class="byline"><span class="full-authors">{a.authors.join(', ')}</span><span class="print-authors">{a.authors.slice(0,3).join(', ')}{a.authors.length>3?' et al.':''}</span></p>
  <div class="detail-dates">
   <span>First online <strong>{formatDate(a.firstOnlineDate)}</strong></span>
   <span>On EM Weekly <strong>{formatDate(a.sitePublishedDate)}</strong></span>
   <span>Discovered <strong>{formatDate(a.discoveredDate)}</strong></span>
   <span class="review-status">{a.aiGenerated?'AI-generated':'Editor-written'} <strong>{a.humanReview}</strong></span>
  </div>
  <DocumentActions title={a.title} printTitle={printTitle}/><div class="reader-actions"><button class="btn" data-save-article={a.id} aria-pressed="false">Save article</button><a class="text-link" href={href('library/')}>My Library & folders</a><span data-save-status role="status" aria-live="polite"></span></div>
  <section class="prose-section"><h2>Summary</h2><Paragraphs text={a.summary}/></section>
  <section class="prose-section"><h2>Why it matters</h2><Paragraphs text={a.whyItMatters}/></section>
  <section class="prose-section study-section"><h2>Study at a glance</h2><dl class="study-facts">{[['Design',a.studyType],['Population',a.population],['Sample size',a.sampleSize||'Not applicable'],['Intervention',a.intervention],['Comparator',a.comparator],['Primary endpoint',a.primaryEndpoint]].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
  <section class="prose-section"><h2>{isGuidance(a)?'Key recommendations':'Main findings'}</h2><ul>{a.findings.map(f=><li>{f}</li>)}</ul></section>
  <section class="prose-section"><h2>Limitations</h2><Paragraphs text={a.limitations}/></section>
  {a.guidelineStrength&&<section class="prose-section"><h2>Recommendation strength</h2><Paragraphs text={a.guidelineStrength}/></section>}
  <section class="prose-section source-box">
   <h2>Read the primary source</h2>
   <p><strong>Full text:</strong> {a.fullTextStatus}.</p>
   <a class="btn primary" href={a.canonicalUrl} target="_blank" rel="noopener noreferrer">Original source <Icon name="external" size={16}/></a>
   {a.officialPdfUrl&&<a class="btn" href={a.officialPdfUrl} target="_blank" rel="noopener noreferrer">Official source PDF <Icon name="external" size={16}/></a>}
   {a.doi&&<p>DOI: <a href={`https://doi.org/${a.doi}`} target="_blank" rel="noopener noreferrer">{a.doi}</a></p>}
   {a.pmid&&<p>PMID: <a href={`https://pubmed.ncbi.nlm.nih.gov/${a.pmid}/`} target="_blank" rel="noopener noreferrer">{a.pmid}</a></p>}
   {!a.doi&&<p class="print-source-detail">Source: <a href={a.canonicalUrl} target="_blank" rel="noopener noreferrer">{a.canonicalUrl}</a></p>}
   <p class="print-source-detail">Material reviewed: {a.reviewedMaterial}.{a.corrections.length>0&&` Latest correction: ${formatDate(a.corrections.at(-1)!.date)}.`}</p>
   <p class="source-notes">Source retrieved {formatDate(a.retrievedAt)}. {a.evidenceNotes}</p>
  </section>
  <div class="topic-chips">{a.topics.map(t=><a href={href(`articles/?topic=${t}`)}>{topics.find(x=>x.id===t)?.name}</a>)}</div>
  <section class="prose-section correction-history"><h2>Corrections & review history</h2>{a.corrections.length?a.corrections.map(c=><p><strong>{formatDate(c.date)}</strong> — {c.description}</p>):<p class="muted">No corrections recorded. Human review: {a.humanReview.toLowerCase()}.</p>}</section>
  <p class="print-footer">{a.aiGenerated?'AI-generated':'Editor-written'} · {a.humanReview} · Read the primary source and apply clinical judgment.</p>
 </article>
<script>import '../../lib/client/reader-actions';</script></Layout>
