---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import {libraryArticles as articles,topics} from '../../lib/data';
const activeTopics=topics.filter(t=>articles.some(a=>a.topics.includes(t.id)));
const years=[...new Set(articles.map(a=>a.firstOnlineDate.slice(0,4)))].sort().reverse();
---
<Layout title="Articles"><div class="page-heading"><div><p class="eyebrow">THE EVIDENCE LIBRARY</p><h1>Articles</h1><p>Research and guidance in one place, organized by original publication date.</p></div><span class="count-pill">{articles.length} summaries</span></div>
<form class="filters evidence-filters" role="search">
 <label class="search-field"><Icon name="search"/><span class="sr-only">Search articles</span><input name="q" type="search" placeholder="Search titles, findings, journals…"/></label>
 <div class="filter-row"><label><span>Topic</span><select name="topic" aria-label="Topic"><option value="">All topics</option>{activeTopics.map(t=><option value={t.id}>{t.name}</option>)}</select></label><label><span>Publication year</span><select name="year" aria-label="Publication year"><option value="">All years</option>{years.map(year=><option>{year}</option>)}</select></label><label><span>Sort by</span><select name="sort" aria-label="Sort by"><option value="">Newest published</option><option value="added">Recently added</option><option value="oldest">Oldest published</option></select></label><button type="reset" class="btn">Reset</button></div>
 <details class="advanced-filters"><summary>More filters <Icon name="plus" size={13}/></summary><div class="filter-row"><label><span>Study type</span><select name="type" aria-label="Study type"><option value="">All study types</option>{[...new Set(articles.map(a=>a.studyType))].sort().map(t=><option>{t}</option>)}</select></label><label><span>First online, from</span><input type="date" name="from" aria-label="First online, from"/></label><label><span>Through</span><input type="date" name="to" aria-label="Through"/></label></div></details>
</form>
<p class="results-meta" aria-live="polite" id="results-count">{articles.length} articles · Newest published first</p><noscript><p class="notice">Enable JavaScript to search and filter. All summaries are readable below.</p></noscript>
<div class="article-grid library">{articles.map(article=><div class="search-result" data-search={`${article.title} ${article.shortTitle} ${article.summary} ${article.source} ${article.topics.join(' ')} ${article.doi} ${article.pmid}`.toLowerCase()} data-topics={article.topics.join(',')} data-type={article.studyType} data-date={article.firstOnlineDate} data-added={article.sitePublishedDate} data-sample={String(article.sample)}><ArticleCard article={article}/></div>)}</div>
<div class="empty-state" id="no-results" hidden><Icon name="search" size={32}/><h2>No matching articles</h2><p>Try a different phrase, topic, or date range.</p><button class="btn" id="clear-search">Clear filters</button></div><div class="pagination" hidden><button class="btn" id="prev">← Previous</button><span id="page-count"></span><button class="btn" id="next">Next →</button></div>
<script>
const form=document.querySelector<HTMLFormElement>('.filters')!;const rows=[...document.querySelectorAll<HTMLElement>('.search-result')];const grid=document.querySelector('.article-grid.library')!;const params=new URLSearchParams(location.search);const keys=['q','topic','year','sort','type','from','to'];for(const key of keys){const el=form.elements.namedItem(key) as HTMLInputElement;el.value=params.get(key)||'';}
if(['type','from','to'].some(k=>params.get(k)))document.querySelector('details.advanced-filters')?.setAttribute('open','');
let page=1;const size=12;
function update(reset=true){
 if(reset)page=1;const d=new FormData(form);const val=(k:string)=>String(d.get(k)||'');const normalize=(s:string)=>s.normalize('NFD').replace(/\p{M}/gu,'').replace(/[’']/g,'').toLowerCase();const q=normalize(val('q').trim());
 const filtered=rows.filter(r=>(!q||normalize(r.dataset.search!).includes(q))&&(!val('topic')||r.dataset.topics!.split(',').includes(val('topic')))&&(!val('year')||r.dataset.date!.startsWith(val('year')))&&(!val('type')||r.dataset.type===val('type'))&&(!val('from')||r.dataset.date!>=val('from'))&&(!val('to')||r.dataset.date!<=val('to')));
 const sort=val('sort');filtered.sort((a,b)=>sort==='added'?b.dataset.added!.localeCompare(a.dataset.added!)||b.dataset.date!.localeCompare(a.dataset.date!):sort==='oldest'?a.dataset.date!.localeCompare(b.dataset.date!):b.dataset.date!.localeCompare(a.dataset.date!));
 const pages=Math.max(1,Math.ceil(filtered.length/size));page=Math.min(page,pages);rows.forEach(r=>r.hidden=true);for(const r of filtered.slice((page-1)*size,page*size)){grid.append(r);r.hidden=false;}
 document.querySelector('#no-results')!.toggleAttribute('hidden',filtered.length>0);document.querySelector('#results-count')!.textContent=`${filtered.length} ${filtered.length===1?'article':'articles'} · ${sort==='added'?'Recently added':sort==='oldest'?'Oldest published first':'Newest published first'}`;
 document.querySelector('.pagination')!.toggleAttribute('hidden',pages<=1);document.querySelector('#page-count')!.textContent=`Page ${page} of ${pages}`;(document.querySelector('#prev') as HTMLButtonElement).disabled=page===1;(document.querySelector('#next') as HTMLButtonElement).disabled=page===pages;
 const p=new URLSearchParams();for(const k of keys)if(val(k))p.set(k,val(k));history.replaceState(null,'',location.pathname+(p.size?'?'+p:''));
}
form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',()=>update());form.addEventListener('reset',()=>{queueMicrotask(()=>update());});document.querySelector('#clear-search')?.addEventListener('click',()=>form.reset());document.querySelector('#prev')?.addEventListener('click',()=>{page--;update(false);document.querySelector('#results-count')?.scrollIntoView({block:'start'});});document.querySelector('#next')?.addEventListener('click',()=>{page++;update(false);document.querySelector('#results-count')?.scrollIntoView({block:'start'});});update();
</script></Layout>
