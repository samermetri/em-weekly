---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import {articles,topics} from '../../lib/data';
---
<Layout title="Latest Articles"><div class="page-heading"><div><p class="eyebrow">THE EVIDENCE LIBRARY</p><h1>Latest articles</h1><p>Primary research and guidance, with the clinical context kept in.</p></div><span class="count-pill">{articles.length} summaries</span></div><form class="filters" role="search"><label class="search-field"><Icon name="search"/><span class="sr-only">Search articles</span><input name="q" type="search" placeholder="Search titles, findings, journals…"/></label><label><span>Topic</span><select name="topic" aria-label="Topic"><option value="">All topics</option>{topics.map(t=><option value={t.id}>{t.name}</option>)}</select></label><label><span>Study type</span><select name="type" aria-label="Study type"><option value="">All study types</option>{[...new Set(articles.map(a=>a.studyType))].map(t=><option>{t}</option>)}</select></label><label><span>First online, from</span><input type="date" name="from" aria-label="First online, from"/></label><label><span>Through</span><input type="date" name="to" aria-label="Through"/></label><button type="reset" class="btn">Reset</button></form><p class="results-meta" aria-live="polite" id="results-count">{articles.length} articles · Sorted by site publication date</p><noscript><p class="notice">Enable JavaScript to search and filter. All summaries are readable below.</p></noscript><div class="article-grid library">{articles.map(article=><div class="search-result" data-search={`${article.title} ${article.shortTitle} ${article.summary} ${article.source} ${article.topics.join(' ')} ${article.doi} ${article.pmid}`.toLowerCase()} data-topics={article.topics.join(',')} data-type={article.studyType} data-date={article.firstOnlineDate}><ArticleCard article={article}/></div>)}</div><div class="empty-state" id="no-results" hidden><Icon name="search" size={32}/><h2>No matching articles</h2><p>Try a different phrase, topic, or date range.</p><button class="btn" id="clear-search">Clear filters</button></div><div class="pagination" hidden><button class="btn" id="prev">← Previous</button><span id="page-count"></span><button class="btn" id="next">Next →</button></div>
<script>
const form=document.querySelector<HTMLFormElement>('.filters')!;const rows=[...document.querySelectorAll<HTMLElement>('.search-result')];const params=new URLSearchParams(location.search);for(const key of ['q','topic','type','from','to']){const el=form.elements.namedItem(key) as HTMLInputElement;el.value=params.get(key)||'';}let page=1;const size=6;
function update(reset=true){if(reset)page=1;const d=new FormData(form);const val=(k:string)=>String(d.get(k)||'');const q=val('q').trim().toLowerCase();const filtered=rows.filter(r=>(!q||r.dataset.search!.includes(q))&&(!val('topic')||r.dataset.topics!.split(',').includes(val('topic')))&&(!val('type')||r.dataset.type===val('type'))&&(!val('from')||r.dataset.date!>=val('from'))&&(!val('to')||r.dataset.date!<=val('to')));const pages=Math.max(1,Math.ceil(filtered.length/size));page=Math.min(page,pages);rows.forEach(r=>r.hidden=true);filtered.slice((page-1)*size,page*size).forEach(r=>r.hidden=false);document.querySelector('#no-results')!.toggleAttribute('hidden',filtered.length>0);document.querySelector('#results-count')!.textContent=`${filtered.length} ${filtered.length===1?'article':'articles'} · Sorted by site publication date`;document.querySelector('.pagination')!.toggleAttribute('hidden',pages<=1);document.querySelector('#page-count')!.textContent=`Page ${page} of ${pages}`;(document.querySelector('#prev') as HTMLButtonElement).disabled=page===1;(document.querySelector('#next') as HTMLButtonElement).disabled=page===pages;const p=new URLSearchParams();for(const k of ['q','topic','type','from','to'])if(val(k))p.set(k,val(k));history.replaceState(null,'',location.pathname+(p.size?'?'+p:''));}
form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',()=>update());form.addEventListener('reset',()=>{queueMicrotask(()=>update());});document.querySelector('#clear-search')?.addEventListener('click',()=>form.reset());document.querySelector('#prev')?.addEventListener('click',()=>{page--;update(false);});document.querySelector('#next')?.addEventListener('click',()=>{page++;update(false);});update();
</script></Layout>
