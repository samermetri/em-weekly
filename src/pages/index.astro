---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {articles,featured,issues,topics,href,state,formatDate} from '../lib/data';
const issue=issues[0];
---
<Layout><div class="page-heading"><div><p class="eyebrow">EM WEEKLY</p><h1>Emergency medicine literature</h1><p>Article summaries, primary sources, and weekly briefs.</p></div><a class="btn" href={href('articles/')}><Icon name="search" size={16}/> Explore the literature</a></div>
<div class="overview-grid"><section class="digest-hero"><div class="hero-copy"><div class="hero-label"><span class="light-dot"></span> THE WEEKLY BRIEF <span class="issue-pill">{issue?.sample?'SAMPLE ISSUE':'LATEST ISSUE'}</span></div><p class="hero-date">{issue?`${formatDate(issue.coverageStart)} – ${formatDate(issue.coverageEnd)}`:'Coming soon'}</p><h2>Weekly literature brief</h2><p class="hero-description">Every article added during the week, with findings, clinical relevance, and limitations.</p><div class="hero-actions"><a class="btn white" href={href(issue?`weekly/${issue.id}/`:'weekly/')}>Read the brief <Icon name="arrow" size={17}/></a>{issue&&<a class="hero-pdf" href={href(`weekly/${issue.id}/?print=1`)}><Icon name="download" size={17}/> Print / Save PDF</a>}</div></div><a class="issue-art" href={href(issue?`weekly/${issue.id}/`:'weekly/')} aria-label="Open the latest weekly brief"><div class="issue-paper"><div class="paper-brand"><Icon name="pulse" size={19}/> EM Weekly.</div><div class="paper-rule"></div><p class="paper-overline">THE LITERATURE BRIEF</p><h3>Weekly<br/>literature brief.</h3><div class="paper-lines"><i></i><i></i><i></i></div><div class="paper-chart"><b></b><b></b><b></b><b></b><b></b><b></b><b></b></div><p class="paper-foot">EMERGENCY MEDICINE</p></div><span class="art-caption">WEEKLY ARCHIVE <Icon name="arrow" size={14}/></span></a></section>
<aside class="research-card"><div class="section-icon"><Icon name="methods" size={21}/></div><p class="eyebrow">PUBLICATION STATUS</p><h2>Sources & review</h2><p>AI-generated summaries with linked primary sources and review status.</p><div class="research-status"><span class="status-dot amber"></span><div><strong>{state.lastSuccessfulResearchCheck?'Research checked':'Research setup in progress'}</strong><span>{state.lastSuccessfulResearchCheck||'No automated research run yet'}</span></div></div><a href={href('methods/')}>How we select & summarize <Icon name="arrow" size={16}/></a></aside></div>
{articles.length>0&&articles.every(a=>a.sample)&&<div class="sample-note"><Icon name="articles" size={16}/><p>Welcome to the first edition. These are verified, historical sample articles. Current weekly coverage begins after the cloud publishing test.</p></div>}
<section class="section"><div class="section-heading"><div><p class="eyebrow">ARTICLES</p><h2>Featured evidence</h2></div><a class="text-link" href={href('articles/')}>All articles <Icon name="arrow" size={16}/></a></div><div class="article-grid">{featured.slice(0,3).map((article,number)=><ArticleCard article={article} number={number}/>)}</div></section>
<div class="bottom-grid"><section class="panel recent-panel"><div class="section-heading"><h2>On the reading list</h2><span class="eyebrow">RECENTLY ADDED</span></div>{articles.slice(0,4).map((a,n)=><a class="reading-row" href={href(`articles/${a.id}/`)}><span class="reading-number">{String(n+1).padStart(2,'0')}</span><div><strong>{a.shortTitle}</strong><span>{a.studyType} · Added {formatDate(a.sitePublishedDate)}</span></div><Icon name="arrow" size={17}/></a>)}</section><section class="panel topic-panel"><div class="section-heading"><h2>Follow your interests</h2><Icon name="topics" size={18}/></div><p>Browse articles by clinical topic.</p><div class="topic-chips">{topics.slice(0,8).map(t=><a href={href(`articles/?topic=${t.id}`)}>{t.name}<Icon name="arrow" size={13}/></a>)}</div><a class="text-link" href={href('topics/')}>Explore all topics <Icon name="arrow" size={15}/></a></section></div></Layout>
