---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import ArticleCard from '../components/ArticleCard.astro';
import {articles,currentArticles,historicalArticles,issues,topics,href,formatDate} from '../lib/data';
const issue=issues.find(i=>!i.sample)??issues[0];const recent=currentArticles.filter(a=>!a.sample);const lead=recent[0]??currentArticles[0];const latest=recent.length?recent:currentArticles;const activeTopics=topics.filter(t=>articles.some(a=>a.topics.includes(t.id)));
---
<Layout>
 <div class="home-heading"><div><p class="eyebrow">THE EVIDENCE READING ROOM</p><h1>Emergency medicine literature</h1><p>Research and guidance for emergency department practice.</p></div><a class="home-library-link" href={href('library/')}><Icon name="bookmark" size={17}/> My saved articles <Icon name="arrow" size={15}/></a></div>
 <form class="home-search" action={href('articles/')} role="search"><Icon name="search" size={20}/><label class="sr-only" for="home-query">Search the evidence library</label><input id="home-query" name="q" type="search" placeholder="Find a study, topic, or clinical question…"/><button class="btn primary" type="submit">Search <Icon name="arrow" size={16}/></button></form>
 <div class="home-topic-row"><span>Browse by topic</span>{activeTopics.slice(0,6).map(t=><a href={href(`articles/?topic=${t.id}`)}>{t.name}</a>)}<a class="home-all-topics" href={href('topics/')}>All topics <Icon name="arrow" size={13}/></a></div>
 <div class="home-editorial-grid">
 {lead&&<article class="home-lead"><div class="home-lead-meta"><span class="eyebrow">RECENT EVIDENCE</span><span>{lead.studyType}</span>{lead.sample&&<span>Historical sample</span>}</div><h2><a href={href(`articles/${lead.id}/`)}>{lead.shortTitle}</a></h2><p>{lead.summary}</p><div class="home-lead-footer"><span>{lead.source} <span>·</span> First online {formatDate(lead.firstOnlineDate)}</span><a href={href(`articles/${lead.id}/`)}>Read summary <Icon name="arrow" size={16}/></a></div></article>}
 <aside class="home-brief"><div class="home-brief-heading"><span class="home-brief-icon"><Icon name="weekly" size={22}/></span><p class="eyebrow">THE WEEKLY BRIEF</p></div><h2>{issue?.sample?'Preview the weekly brief':'This week’s evidence'}</h2><p class="home-brief-date">{issue?`${formatDate(issue.coverageStart)}–${formatDate(issue.coverageEnd)}`:'First issue coming soon'}</p><p>{issue?.sample?'A sample showing how the weekly brief brings article summaries together.':'All current-coverage articles added that week, with clinical takeaways and source links.'}</p><div class="home-brief-actions"><a class="btn" href={href(issue?`weekly/${issue.id}/`:'weekly/')}>Read the brief <Icon name="arrow" size={16}/></a>{issue&&<a class="home-print-link" href={href(`weekly/${issue.id}/?print=1`)}><Icon name="download" size={14}/> Print / Save PDF</a>}</div><a class="home-brief-archive" href={href('weekly/')}>Browse previous briefs <Icon name="arrow" size={14}/></a></aside>
 </div>
 <section class="home-latest"><div class="section-heading"><div><p class="eyebrow">CURRENT COVERAGE</p><h2>Latest articles</h2></div><a class="text-link" href={href('articles/?collection=current')}>View all <Icon name="arrow" size={15}/></a></div><div class="article-grid">{latest.slice(0,3).map(article=><ArticleCard article={article}/>)}</div></section>
 <section class="home-archive-strip"><div class="home-archive-icon"><Icon name="clock" size={25}/></div><div><p class="eyebrow">HISTORICAL COLLECTION</p><h2>Explore the evidence behind current practice</h2><p>Selected research from October 2024–October 2026. {historicalArticles.length?`${historicalArticles.length} summaries added so far.`:'Retrospective research is underway.'}</p></div><a class="btn" href={href('historical/')}>Browse collection <Icon name="arrow" size={16}/></a></section>
</Layout>
