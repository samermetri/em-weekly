---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import ArticleCard from '../components/ArticleCard.astro';
import {libraryArticles,issues,topics,href,formatDate} from '../lib/data';
const issue=issues.find(i=>!i.sample);const lead=libraryArticles[0];
const activeTopics=topics.filter(t=>libraryArticles.some(a=>a.topics.includes(t.id)));
const years=[...new Set(libraryArticles.map(a=>a.firstOnlineDate.slice(0,4)))].sort().reverse();
---
<Layout>
 <div class="home-heading"><div><p class="eyebrow">RESEARCH & GUIDANCE</p><h1>Emergency medicine literature</h1><p>Browse the evidence by clinical question, topic, or publication date.</p></div><span class="library-total"><strong>{libraryArticles.length}</strong> article summaries</span></div>
 <form class="home-search" action={href('articles/')} role="search"><Icon name="search" size={20}/><label class="sr-only" for="home-query">Search the evidence library</label><input id="home-query" name="q" type="search" placeholder="Find a study, topic, or clinical question…"/><button class="btn primary" type="submit">Search <Icon name="arrow" size={16}/></button></form>
 <div class="home-topic-row"><span>Explore</span>{activeTopics.slice(0,6).map(t=><a href={href(`articles/?topic=${t.id}`)}>{t.name}</a>)}<a class="home-all-topics" href={href('topics/')}>All topics <Icon name="arrow" size={13}/></a></div>
 <div class="reading-layout"><div class="reading-main">
 {lead&&<article class="home-lead"><div class="home-lead-meta"><span class="eyebrow">LATEST PUBLICATION</span><span>{lead.studyType}</span></div><h2><a href={href(`articles/${lead.id}/`)}>{lead.shortTitle}</a></h2><p>{lead.summary}</p><div class="home-lead-footer"><span>{lead.source}<br/>First online {formatDate(lead.firstOnlineDate)}</span><a href={href(`articles/${lead.id}/`)}>Read summary <Icon name="arrow" size={16}/></a></div></article>}
 <section class="home-latest"><div class="section-heading"><div><h2>From the library</h2><p>In order of original publication.</p></div><a class="text-link" href={href('articles/')}>All articles <Icon name="arrow" size={15}/></a></div><div class="article-grid">{libraryArticles.slice(1,7).map(article=><ArticleCard article={article}/>)}</div></section>
 </div><aside class="reading-aside">
 <section class="publication-note"><p class="eyebrow">THE WEEKLY BRIEF</p><Icon name="weekly" size={27}/><h2>{issue?'This week’s evidence':'One week of evidence'}</h2><p>{issue?`${formatDate(issue.coverageStart)}–${formatDate(issue.coverageEnd)}`:'New research and guidance, brought together each Monday.'}</p>{issue?<a class="btn" href={href(`weekly/${issue.id}/`)}>Read the brief <Icon name="arrow" size={15}/></a>:<a class="text-link" href={href('weekly/')}>Weekly briefs <Icon name="arrow" size={15}/></a>}</section>
 <section class="year-navigation"><h2>Browse by year</h2>{years.map(year=><a href={href(`articles/?year=${year}`)}><span>{year}</span><span>{libraryArticles.filter(a=>a.firstOnlineDate.startsWith(year)).length}<Icon name="arrow" size={15}/></span></a>)}</section>
 <p class="coverage-note">The library is growing. Earlier research from 2024–2026 is being added as source checks are completed; coverage is not yet comprehensive.</p>
 <a class="aside-saved" href={href('library/')}><Icon name="bookmark" size={18}/><span>Your saved articles<small>Keep papers and organize folders</small></span><Icon name="arrow" size={15}/></a>
 </aside></div>
</Layout>
