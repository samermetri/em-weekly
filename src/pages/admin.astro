---
import Layout from '../layouts/Layout.astro';import {href,topics} from '../lib/data';import {sections} from '../lib/schema';
const texts=[['id','Article ID'],['title','Full title'],['shortTitle','Short title'],['source','Journal / organization'],['firstOnlineDate','First online'],['sitePublishedDate','On EM Weekly'],['discoveredDate','Discovered'],['retrievedAt','Source retrieved']];
const narratives=[['authors','Authors (one per line)'],['summary','Summary'],['whyItMatters','Why it matters'],['limitations','Limitations'],['findings','Main findings (one per line)']];
const details=[['population','Population'],['sampleSize','Sample size'],['intervention','Intervention'],['comparator','Comparator'],['primaryEndpoint','Primary endpoint'],['canonicalUrl','Primary-source URL'],['doi','DOI'],['pmid','PMID'],['officialPdfUrl','Official PDF URL'],['evidenceNotes','Source access / material reviewed'],['guidelineStrength','Recommendation strength']];
const types=['Randomized trial','Observational study','Diagnostic study','Meta-analysis','Guideline','Consensus statement','Review','Preprint','Commentary','Quality improvement'];
---
<Layout title="Manage articles"><div class="page-heading"><div><p class="eyebrow">EDITORIAL WORKSPACE</p><h1>Manage articles</h1><p>Review, edit, tag, and publish original article summaries.</p></div><a class="btn" href={href('library/')}>My Library</a></div><p class="account-status" data-account-status role="status" aria-live="polite">Checking administrator access…</p><div id="admin-workspace" hidden><div class="reader-row admin-toolbar"><input id="admin-search" type="search" aria-label="Search managed articles" placeholder="Find an article"/><select id="admin-filter" aria-label="Review filter"><option value="all">All articles</option><option value="pending">Needs review</option><option value="withdrawn">Withdrawn / held</option></select><button id="new-article" class="btn primary">Add article</button><button id="publication-check" class="btn">Check publication</button></div><div class="admin-grid"><aside class="panel" id="admin-articles"></aside><section class="panel"><form id="article-editor" class="reader-form" hidden><div class="reader-row"><h2 id="editor-title">Edit article</h2><span id="editor-revision" class="muted"></span></div><div class="form-grid">{texts.map(([name,label])=><label>{label}<input name={name} required type={name.endsWith('Date')||name==='retrievedAt'?'date':'text'}/></label>)}</div>{narratives.map(([name,label])=><label>{label}<textarea name={name} rows={name==='authors'?2:4} required></textarea></label>)}<div class="form-grid"><label>Study type<select name="studyType">{types.map(t=><option>{t}</option>)}</select></label><label>Section<select name="section">{sections.map(t=><option>{t}</option>)}</select></label><label>Visibility<select name="status"><option value="published">Published</option><option value="held">Held for review</option></select></label><label>Review status<select name="humanReview"><option>Not yet human-reviewed</option><option>Human-reviewed</option></select></label></div><fieldset><legend>Topics</legend><div class="topic-choices">{topics.map(t=><label class="check-line"><input name="topic" type="checkbox" value={t.id}/>{t.name}</label>)}</div></fieldset><details><summary>Study details, source access & ranking</summary>{details.map(([name,label])=><label>{label}{['population','intervention','comparator','primaryEndpoint','evidenceNotes','guidelineStrength'].includes(name)?<textarea name={name} rows="2"/>:<input name={name} type={name==='sampleSize'?'number':'text'} min="1"/>}</label>)}<label>Material actually reviewed<select name="reviewedMaterial"><option value="abstract">Abstract</option><option value="full text">Full text</option><option value="official society summary">Official society summary</option></select></label><label>Source availability<select name="fullTextStatus"><option>Abstract available; full text paywalled</option><option>Open-access full text available</option><option>Official PDF available</option><option>Official society summary available</option></select></label><div class="form-grid">{[['edImpact','ED impact'],['design','Design'],['novelty','Novelty'],['guidelineRelevance','Guideline relevance']].map(([name,label])=><label>{label} (0–5)<input name={`ranking.${name}`} type="number" min="0" max="5" required/></label>)}</div><div class="topic-choices">{[['aiGenerated','AI-generated / AI-assisted'],['pinned','Pinned'],['sample','Historical sample'],['excluded','Excluded from public lists']].map(([name,label])=><label class="check-line"><input name={name} type="checkbox"/>{label}</label>)}</div></details><label>Edit / correction reason<input name="reason" required maxlength="500" placeholder="Describe this change for the dated history"/></label><div class="reader-row"><button class="btn primary" type="submit">Save article</button><button class="btn" id="mark-reviewed" type="button">Mark human-reviewed</button><button class="btn danger" id="withdraw-article" type="button">Delete / withdraw</button><button class="btn" id="restore-article" type="button" hidden>Restore article</button></div><p class="muted">Saving records a revision and dated history. The public site updates after validation and deployment; cached pages can take up to 10 minutes to refresh. Deleting withdraws the article and can be reversed.</p></form><p id="editor-empty" class="muted">Choose an article or add a new one.</p></section></div></div><script>import '../lib/client/admin-page';</script></Layout>
