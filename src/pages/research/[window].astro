---
import {href} from '../../lib/data';
import {researchWindows} from '../../lib/research-index';
export function getStaticPaths(){return researchWindows().map(window=>({params:{window:window.start},props:{window}}));}
const {window:w}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Research candidates: {w.start}–{w.end} · EM Weekly</title></head><body><main><h1>Research discovery: {w.start}–{w.end}</h1><p>Unreviewed metadata candidates from official PubMed searches, captured {w.retrievedAt}. These are not EM Weekly article summaries. Publication-date search results require primary first-online date verification before selection. Index retrieval does not constitute a completed literature review or guideline search.</p><h2>Discovery queries</h2><ul>{w.sources.map(s=><li>{s.id}: {s.count} candidates. Query: {s.query}. {s.requests.map((url,i)=><a href={url}>Official search {i+1} </a>)}</li>)}</ul><h2>Candidate pages ({w.candidates.length} records)</h2><ol>{Array.from({length:Math.ceil(w.candidates.length/100)},(_,i)=><li><a href={href(`research/${w.start}/page/${i+1}/`)}>Page {i+1}: records {i*100+1}–{Math.min((i+1)*100,w.candidates.length)}</a></li>)}</ol><h2>First 100 records</h2>{w.candidates.slice(0,100).map(c=><article><h3><a href={`https://pubmed.ncbi.nlm.nih.gov/${c.pmid}/`}>{c.title}</a></h3><p>{c.metadataIssue&&<strong>Metadata limitation: {c.metadataIssue}. </strong>}PMID {c.pmid} · {c.journal} · Publication metadata: {c.pubDate}; electronic metadata: {c.epubDate||'not supplied'}. Types: {c.types.join('; ')}. Source groups: {c.sourceIds.join(', ')}.</p>{c.doi&&<a href={`https://doi.org/${c.doi}`}>DOI {c.doi}</a>}</article>)}</main></body></html>
