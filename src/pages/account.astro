---
import Layout from '../layouts/Layout.astro';import {href} from '../lib/data';
---
<Layout title="Your account"><div class="page-heading"><div><p class="eyebrow">YOUR READING LIST</p><h1>Your EM Weekly account</h1><p>Save useful articles and organize them into private folders.</p></div></div><section class="panel auth-panel"><div class="auth-tabs"><button type="button" data-auth-mode="signin" class="selected">Sign in</button><button type="button" data-auth-mode="signup">Create account</button></div><p id="auth-message" class="muted"></p><form id="auth-form" class="reader-form"><label>Email<input name="email" type="email" required autocomplete="email"/></label><label>Password<input name="password" type="password" required autocomplete="current-password"/></label><button class="btn primary" type="submit">Sign in</button></form><button class="link-button" data-auth-mode="reset">Forgot password?</button><p class="account-status" data-account-status role="status" aria-live="polite"></p><div id="signed-in" hidden><p>Signed in as <span data-email></span>.</p><div class="reader-row"><a class="btn" href={href('library/')}>Open My Library</a><button class="btn" data-sign-out>Sign out</button></div></div><p class="muted">Public articles are free to read without an account. An account is only needed to save and organize.</p></section><script>import '../lib/client/auth-page';</script></Layout>
