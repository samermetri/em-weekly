---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import {href} from '../lib/data';
import '../styles/reading-space.css';
---
<Layout title="Your account">
 <div class="account-space">
 <a class="account-back" href={href('articles/')}><span aria-hidden="true">←</span> Back to articles</a>
 <section class="panel auth-panel" aria-labelledby="auth-title" aria-busy="true">
 <div class="auth-tabs" aria-label="Account action"><button type="button" data-auth-mode="signin" class="selected" aria-pressed="true">Sign in</button><button type="button" data-auth-mode="signup" aria-pressed="false">Create account</button></div>
 <div class="auth-intro"><span class="account-symbol"><Icon name="bookmark" size={23}/></span><h1 id="auth-title">Welcome back</h1><p id="auth-description">Sign in to your saved articles and folders.</p></div>
 <p id="auth-message" class="muted"></p>
 <form id="auth-form" class="reader-form"><label>Email<input name="email" type="email" required autocomplete="email" placeholder="you@example.com"/></label><div class="auth-password-field"><div class="password-label"><label for="account-password">Password</label><button type="button" class="link-button" data-auth-mode="reset">Forgot password?</button></div><span class="password-input"><input id="account-password" aria-label="Password" name="password" type="password" required autocomplete="current-password" placeholder="Your password"/><button class="password-toggle" type="button" aria-controls="account-password" aria-label="Show password" aria-pressed="false">Show</button></span></div><button class="btn primary" type="submit">Sign in <Icon name="arrow" size={17}/></button></form>
 <button class="link-button auth-back" data-auth-mode="signin" hidden>← Back to sign in</button>
 <p class="account-status" data-account-status role="status" aria-live="polite"></p>
 <div id="signed-in" hidden><div class="account-identity"><span class="library-avatar" data-account-avatar aria-hidden="true">R</span><div><span class="identity-label">Signed in as</span><strong data-email></strong></div></div><a class="btn primary account-open" href={href('library/')}>Open My Library <Icon name="arrow" size={17}/></a><div class="account-destinations"><a href={href('articles/')}><Icon name="articles" size={18}/> Browse articles <Icon name="arrow" size={16}/></a><a href={href('weekly/')}><Icon name="weekly" size={18}/> Weekly briefs <Icon name="arrow" size={16}/></a></div><button class="link-button account-signout" data-sign-out>Sign out</button></div>
 <p class="auth-note"><Icon name="methods" size={14}/> Your saved articles and folders are private.</p>
 </section><p class="account-outside">You can <a href={href('articles/')}>read every article</a> without an account.</p>
 </div><script>import '../lib/client/auth-page';</script>
</Layout>
