---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import {topics,libraryArticles as articles,href} from '../lib/data';
---
<Layout title="Topics"><div class="page-heading"><div><p class="eyebrow">EVIDENCE BY CLINICAL QUESTION</p><h1>Find your focus.</h1><p>Explore research and guidance across the breadth of emergency care.</p></div></div><div class="topics-grid">{topics.filter(t=>articles.some(a=>a.topics.includes(t.id))).map(t=><a class="panel topic-card" href={href(`articles/?topic=${t.id}`)}><span class="topic-number">{t.number}</span><h2>{t.name}</h2><p>{t.description}</p><div><span>{articles.filter(a=>a.topics.includes(t.id)).length} summaries</span><Icon name="arrow" size={19}/></div></a>)}</div></Layout>
