---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {href} from '../../lib/data';
---
<Layout title="Reading digest" description="Print selected EM Weekly articles together as a personal reading digest.">
 <div class="page-heading digest-preview-heading"><div><p class="eyebrow">YOUR READING DIGEST</p><h1>Print your selection</h1><p>Review the articles below, then print or save them together as one PDF.</p></div><a class="text-link" href={href('library/')}>My Library <Icon name="arrow" size={15}/></a></div>
 <div class="digest-preview-tools document-actions"><label><span>Format</span><select id="digest-format"><option value="compact">Compact digest</option><option value="expanded">Include main findings</option></select></label><p>Page count depends on your selection. All summaries, limitations and source links are retained.</p><button type="button" class="btn primary" id="print-digest" disabled><Icon name="download" size={16}/> Print / Save as PDF</button></div>
 <p class="account-status document-actions" id="digest-status" role="status" aria-live="polite">Loading your selection…</p>
 <article class="personal-digest" id="personal-digest" data-format="compact" hidden><header class="digest-document-heading"><a class="digest-wordmark" href={href()}>EM Weekly.</a><span>READING DIGEST</span><h2>Selected articles</h2><p id="digest-meta"></p></header><div id="digest-articles"></div><p class="digest-disclaimer">AI-generated summaries carry their review status on each article. For professional education. Read the primary sources and apply clinical judgment.</p></article>
 <noscript><p class="notice">Enable JavaScript to load your selected articles. Individual article pages can be printed without selecting a digest.</p></noscript>
 <script>import '../../lib/client/digest-page';</script>
</Layout>
