---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import ArticleCard from '../components/ArticleCard.astro';import {historicalArticles,href,formatDate} from '../lib/data';import fs from 'node:fs';import {backfillSchema} from '../lib/schema';
const progress=backfillSchema.parse(JSON.parse(fs.readFileSync('state/backfill.json','utf8')));const completed=progress.windows.filter(w=>w.status==='complete').length;
---
<Layout title="Historical collection" description="Verified emergency medicine evidence first published October 2024 through October 2026, collected retrospectively."><div class="page-heading"><div><p class="eyebrow">THE HISTORICAL COLLECTION</p><h1>Two years of emergency medicine evidence</h1><p>First published {formatDate(progress.rangeStart)}–{formatDate(progress.rangeEnd)}. Collected retrospectively, with original source dates preserved.</p></div></div><section class="historical-status panel"><div><span class="collection-label">{progress.status==='complete'?'Research complete':'Backfill in progress'}</span><h2>{historicalArticles.length} verified {historicalArticles.length===1?'summary':'summaries'}</h2><p>{completed} of {progress.windows.length} research windows fully checked. Articles publish in verified batches; coverage is incomplete until the source checks are finished.</p></div><a class="btn" href={href('articles/?collection=historical')}><Icon name="search" size={16}/> Search the collection</a></section><p class="historical-context">These articles remain searchable with all evidence and can be saved to your library. They are separate from current weekly briefs. Older guidance may have been superseded; check the primary source and publication date.</p>{historicalArticles.length?<div class="article-grid library">{historicalArticles.slice(0,12).map(article=><ArticleCard article={article}/>)}</div>:<div class="empty-library"><h2>The historical collection is being researched</h2><p>Verified summaries will appear here as source checks are completed.</p></div>}{historicalArticles.length>12&&<a class="btn" href={href('articles/?collection=historical')}>Browse all {historicalArticles.length} summaries <Icon name="arrow" size={16}/></a>}</Layout>
