---
import Icon from './Icon.astro';
const {title,printTitle,articleId,noteArticleIds=[],shareUrl=new URL(Astro.url.pathname,Astro.site).href}=Astro.props;
const noteIds=articleId?[articleId]:noteArticleIds;
---
<div class="document-actions" data-document-title={title} data-print-title={printTitle} data-share-url={shareUrl}>
  <button class="btn primary print-button" type="button"><Icon name="download" size={16}/> Print / Save as PDF</button>
  <button class="btn share-button" type="button"><Icon name="share" size={16}/> Share</button>
  {noteIds.length>0&&<label class="print-notes-toggle"><input type="checkbox" data-print-note={noteIds.join(',')}/> Include my notes</label>}
  <span class="share-status" role="status" aria-live="polite"></span>
  <label class="share-fallback" hidden>Copy article link <input type="text" readonly value={shareUrl}/></label>
</div>
<script>
const actions=document.querySelector<HTMLElement>('.document-actions');
if(actions){
 const originalTitle=document.title;
 const notesToggle=actions.querySelector<HTMLInputElement>('[data-print-note]');
 const printButton=actions.querySelector<HTMLButtonElement>('.print-button');
 let noteGeneration=0;
 async function updatePrivateNote(refresh=false){
  if(!notesToggle)return;const turn=++noteGeneration;const targets=[...document.querySelectorAll<HTMLElement>('[data-print-note-id]')];for(const section of targets){section.hidden=true;section.querySelector('p')!.textContent='';}
  if(!notesToggle.checked){if(printButton)printButton.disabled=false;return;}
  if(printButton)printButton.disabled=true;
  const noteStatus=actions!.querySelector<HTMLElement>('.note-print-status')||document.createElement('span');noteStatus.className='note-print-status';noteStatus.setAttribute('role','status');noteStatus.textContent='Loading your note…';actions!.append(noteStatus);
  try{const {readNotes}=await import('../lib/client/private-notes');const {notes}=await readNotes(notesToggle.dataset.printNote!.split(','),refresh);if(turn!==noteGeneration)return;let count=0;for(const section of targets){const text=notes.get(section.dataset.printNoteId!)?.note||'';section.querySelector('p')!.textContent=text;section.hidden=!text;if(text)count++;}noteStatus.textContent=count?`${count} private ${count===1?'note is':'notes are'} included below.`:'No saved notes for these articles.';}
  catch(e){if(turn!==noteGeneration)return;notesToggle.checked=false;noteStatus.textContent=(e as Error).message;}
  finally{if(turn===noteGeneration&&printButton)printButton.disabled=false;}
 }
 notesToggle?.addEventListener('change',()=>{if(!notesToggle.checked)actions!.querySelector('.note-print-status')?.remove();void updatePrivateNote();});
 document.addEventListener('em-note-removed',()=>{if(notesToggle){notesToggle.checked=false;void updatePrivateNote();actions!.querySelector('.note-print-status')?.remove();}});
 document.addEventListener('em-note-saved',()=>{if(notesToggle?.checked)void updatePrivateNote();});
 function printDocument(){document.fonts.ready.then(()=>{document.title=actions!.dataset.printTitle||originalTitle;requestAnimationFrame(()=>window.print());});}
 window.addEventListener('afterprint',()=>{document.title=originalTitle;});
 actions.querySelector('.print-button')?.addEventListener('click',printDocument);
 if(new URLSearchParams(location.search).get('print')==='1'){history.replaceState(null,'',location.pathname);printDocument();}
 actions.querySelector('.share-button')?.addEventListener('click',async()=>{
  const url=actions.dataset.shareUrl!;const title=actions.dataset.documentTitle!;
  const status=actions.querySelector<HTMLElement>('.share-status')!;
  try{
   if(navigator.share){await navigator.share({title,url});return;}
   await navigator.clipboard.writeText(url);status.textContent='Link copied';
  }catch(error){
   if(error instanceof DOMException&&error.name==='AbortError')return;
   const fallback=actions.querySelector<HTMLElement>('.share-fallback')!;fallback.hidden=false;
   const field=fallback.querySelector('input')!;field.focus();field.select();status.textContent='Copy the link below';
  }
 });
}
</script>
