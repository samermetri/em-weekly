---
import type {Article} from '../lib/schema';
import {href,topics,formatDate} from '../lib/data';
import Icon from './Icon.astro';
interface Props {article:Article;number?:number}
const {article:a}=Astro.props;
const material=a.reviewedMaterial==='abstract'?'Abstract reviewed':a.reviewedMaterial==='official society summary'?'Society summary reviewed':'Full text reviewed';
---
<article class="article-card">
 <div class="article-top"><span class:list={['tag',a.topics[0]]}>{topics.find(t=>t.id===a.topics[0])?.name}</span><span class="study-type">{a.studyType}</span>{a.sample&&<span class="study-type">Sample</span>}</div>
 <h3><a href={href(`articles/${a.id}/`)}>{a.shortTitle}</a></h3>
 <p>{a.summary}</p>
 <div class="article-meta"><span>{a.source}</span><time datetime={a.firstOnlineDate}>First online {formatDate(a.firstOnlineDate)}</time></div>
 <div class="article-bottom"><span>{a.aiGenerated?'AI-generated':'Editor-written'} · {material}</span><a href={href(`articles/${a.id}/`)} aria-label={`Read ${a.shortTitle}`}><Icon name="arrow" size={18}/></a></div>
</article>
