---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {href} from '../lib/data';
const {title='Overview',description='Emergency medicine evidence, thoughtfully selected. Source-linked literature summaries and weekly clinical briefs.'}=Astro.props;
const current=Astro.url.pathname;
const nav=[['','Overview','overview'],['articles/','Latest Articles','articles'],['weekly/','Weekly Updates','weekly'],['topics/','Topics','topics'],['methods/','Sources & Methods','methods']];
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · EM Weekly</title><meta name="description" content={description}/><meta name="theme-color" content="#345a43"/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} · EM Weekly`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><link rel="icon" href={href('favicon.svg')}/><link rel="alternate" type="application/rss+xml" title="EM Weekly" href={href('rss.xml')}/></head>
<body><a class="skip" href="#main">Skip to content</a><aside class="sidebar"><a class="brand" href={href()}><span class="brand-mark"><Icon name="pulse" size={24}/></span><span>EM Weekly<span class="brand-dot">.</span></span></a><p class="brand-sub">EMERGENCY MEDICINE LITERATURE</p><button class="mobile-toggle" aria-label="Toggle navigation" aria-expanded="false"><Icon name="menu"/></button><nav id="navigation" aria-label="Main navigation"><p class="nav-label">LIBRARY</p>{nav.map(([path,label,icon])=><a href={href(path)} class:list={['nav-link',{active:path?current.startsWith(href(path)):current===href()}]} aria-current={(path?current.startsWith(href(path)):current===href())?'page':undefined}><Icon name={icon}/><span>{label}</span>{label==='Weekly Updates'&&<span class="nav-new">WEEKLY</span>}</a>)}</nav><div class="sidebar-bottom"><a class="sidebar-rss" href={href('rss.xml')}><Icon name="rss" size={16}/> Follow the RSS feed <Icon name="external" size={13}/></a><p class="sidebar-caption">Free access · Primary sources linked</p></div></aside>
<div class="shell"><header class="topbar"><div class="breadcrumb">Reading room <span>/</span> <strong>{title.length>40?'Article':title}</strong></div><div class="topbar-right"><span class="status-dot"></span> Public literature brief <a href={href('articles/')} aria-label="Search articles"><Icon name="search" size={18}/></a></div></header><main id="main" tabindex="-1"><slot/></main><footer class="footer"><span>EM Weekly</span><a href={href('methods/')}>AI-generated summaries · Review status on every article <Icon name="arrow" size={14}/></a><p>For professional education. Read the primary source and apply clinical judgment.</p></footer></div>
<script>const toggle=document.querySelector<HTMLButtonElement>('.mobile-toggle');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));document.querySelector('.sidebar')?.classList.toggle('open',open);});</script>
</body></html>
